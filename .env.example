# Copy to .env and adjust. make and docker compose both read .env.

# Public URL when the app sits behind a reverse proxy. Leave unset for http://localhost:3003.
# LOS_PUBLIC_ORIGIN=https://loans.example.com

# Key that signs the session cookie. Unset: random per start, so an API restart signs everyone out.
# LOS_SESSION_SECRET=change-me-to-a-long-random-string

# Shared password for the sign in page. Unset: one click sign in.
# LOS_LOGIN_PASSWORD=

# Local JDK 21 and Maven installs, if they are not on PATH.
# JAVA_HOME=/opt/jdk21
# MAVEN_HOME=/opt/maven
